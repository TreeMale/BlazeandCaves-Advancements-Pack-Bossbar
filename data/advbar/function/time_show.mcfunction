scoreboard players set #mode advbar_cfg 1
scoreboard players set #slot advbar_cfg 0
scoreboard players set #showcd advbar_cfg 50
function advbar:time_fmt
# ветка 1: есть реальные дни, есть минуты — X д. Y ч. Z мин.
execute if score #rd advbar_time matches 1.. if score #rm advbar_time matches 1.. run bossbar set minecraft:advancements_progress name [{"text":"День ","color":"gold"},{"score":{"name":"#days","objective":"advbar_time"},"color":"aqua"},{"text":" • ","color":"gray"},{"text":"В игре: ","color":"gold"},{"score":{"name":"#rd","objective":"advbar_time"},"color":"aqua"},{"text":" д. ","color":"gray"},{"score":{"name":"#rh","objective":"advbar_time"},"color":"aqua"},{"text":" ч. ","color":"gray"},{"score":{"name":"#rm","objective":"advbar_time"},"color":"aqua"},{"text":" мин.","color":"gray"}]
# ветка 2: есть дни, минуты нулевые — X д. Y ч.
execute if score #rd advbar_time matches 1.. if score #rm advbar_time matches ..0 run bossbar set minecraft:advancements_progress name [{"text":"День ","color":"gold"},{"score":{"name":"#days","objective":"advbar_time"},"color":"aqua"},{"text":" • ","color":"gray"},{"text":"В игре: ","color":"gold"},{"score":{"name":"#rd","objective":"advbar_time"},"color":"aqua"},{"text":" д. ","color":"gray"},{"score":{"name":"#rh","objective":"advbar_time"},"color":"aqua"},{"text":" ч.","color":"gray"}]
# ветка 3: меньше суток, есть минуты — Y ч. Z мин.
execute if score #rd advbar_time matches ..0 if score #rh advbar_time matches 1.. if score #rm advbar_time matches 1.. run bossbar set minecraft:advancements_progress name [{"text":"День ","color":"gold"},{"score":{"name":"#days","objective":"advbar_time"},"color":"aqua"},{"text":" • ","color":"gray"},{"text":"В игре: ","color":"gold"},{"score":{"name":"#rh","objective":"advbar_time"},"color":"aqua"},{"text":" ч. ","color":"gray"},{"score":{"name":"#rm","objective":"advbar_time"},"color":"aqua"},{"text":" мин.","color":"gray"}]
# ветка 4: меньше суток, минуты нулевые — Y ч.
execute if score #rd advbar_time matches ..0 if score #rh advbar_time matches 1.. if score #rm advbar_time matches ..0 run bossbar set minecraft:advancements_progress name [{"text":"День ","color":"gold"},{"score":{"name":"#days","objective":"advbar_time"},"color":"aqua"},{"text":" • ","color":"gray"},{"text":"В игре: ","color":"gold"},{"score":{"name":"#rh","objective":"advbar_time"},"color":"aqua"},{"text":" ч.","color":"gray"}]
# ветка 5: меньше часа — Z мин.
execute if score #rd advbar_time matches ..0 if score #rh advbar_time matches ..0 run bossbar set minecraft:advancements_progress name [{"text":"День ","color":"gold"},{"score":{"name":"#days","objective":"advbar_time"},"color":"aqua"},{"text":" • ","color":"gray"},{"text":"В игре: ","color":"gold"},{"score":{"name":"#rm","objective":"advbar_time"},"color":"aqua"},{"text":" мин.","color":"gray"}]
