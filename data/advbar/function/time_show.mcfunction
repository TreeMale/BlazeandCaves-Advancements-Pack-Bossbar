scoreboard players set #mode advbar_cfg 1
scoreboard players set #slot advbar_cfg 0
scoreboard players operation #showcd advbar_cfg = #time_ticks advbar_cfg
function advbar:time_fmt
$execute if score #th advbar_time matches 1.. if score #rm advbar_time matches 1.. run bossbar set minecraft:advancements_progress name [{"text":$(day),"color":"$(heading_color)"},{"score":{"name":"#days","objective":"advbar_time"},"color":"$(value_color)"},{"text":$(separator),"color":"$(detail_color)"},{"text":$(played),"color":"$(heading_color)"},{"score":{"name":"#th","objective":"advbar_time"},"color":"$(value_color)"},{"text":$(hours_space),"color":"$(detail_color)"},{"score":{"name":"#rm","objective":"advbar_time"},"color":"$(value_color)"},{"text":$(minutes),"color":"$(detail_color)"}]
$execute if score #th advbar_time matches 1.. if score #rm advbar_time matches ..0 run bossbar set minecraft:advancements_progress name [{"text":$(day),"color":"$(heading_color)"},{"score":{"name":"#days","objective":"advbar_time"},"color":"$(value_color)"},{"text":$(separator),"color":"$(detail_color)"},{"text":$(played),"color":"$(heading_color)"},{"score":{"name":"#th","objective":"advbar_time"},"color":"$(value_color)"},{"text":$(hours),"color":"$(detail_color)"}]
$execute if score #th advbar_time matches ..0 run bossbar set minecraft:advancements_progress name [{"text":$(day),"color":"$(heading_color)"},{"score":{"name":"#days","objective":"advbar_time"},"color":"$(value_color)"},{"text":$(separator),"color":"$(detail_color)"},{"text":$(played),"color":"$(heading_color)"},{"score":{"name":"#rm","objective":"advbar_time"},"color":"$(value_color)"},{"text":$(minutes),"color":"$(detail_color)"}]
